# ---------------------------------------------------------------------------
# CSMJU Quiz backend — ตัวอย่าง environment
# คัดลอกเป็น .env ก่อนรัน (ห้าม commit .env)
# พอร์ตเครื่องพัฒนา: 3000 Core Hub backend · 3100 Core Hub frontend
#   · 3001 สงวนให้ demo (ห้ามใช้) · 3002 backend นี้ · 3102 frontend ของ CSMJU Quiz
#
# standards 1.7.0 (connect-core-hub ข้อ 0–1): frontend http://localhost:3102 คือ "ประตูเดียว" ของระบบ
#   เบราว์เซอร์เปิดแค่ :3102 · Next.js proxy /api/* · /auth/login · /auth/callback · /auth/logout มาที่ backend นี้
#   ⚠️ Callback URL ในทะเบียน Core Hub ต้องเป็น http://localhost:3102/auth/callback (พอร์ต frontend ไม่ใช่ 3002)
#      และ base_url ใน subsystem.yaml = http://localhost:3102
# คุกกี้ที่ระบบนี้ตั้ง (ผูกกับ origin ของ frontend เพราะมาทาง proxy):
#   csmju_quiz_access_token  session = Core Hub token ที่ verify แล้ว (HttpOnly · SameSite=Lax · Path=/ · อายุ = exp)
#   csmju_quiz_sso_state     state ของ /auth/login (HttpOnly · Path=/auth/callback · 600 วินาที)
#   quiz_room_pass           บัตรเข้าห้องของผู้เล่นที่ไม่ล็อกอิน
#   ระบบนี้ไม่อ่านคุกกี้ของเว็บ Core Hub (csmju_access_token · csmju_refresh_token)
# server จริง (โหมดก่อนเปิดใช้): CORE_HUB_URL / CORE_HUB_WEB_URL = https://csmju2030.jowave.com
#   CORE_HUB_JWKS_URL = https://csmju2030.jowave.com/api/v1/.well-known/jwks.json
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3002

# ฐานข้อมูลของระบบย่อยนี้เท่านั้น — ห้ามชี้ไปที่ฐานข้อมูลของ Core Hub (core_hub)
# ใช้ PostgreSQL ตัวเดียวกับ Core Hub ที่พอร์ต 5432 แต่แยกฐานข้อมูลชื่อ quiz_db
#   ตัวอย่าง: postgresql://<user>:<password>@localhost:5432/quiz_db
DATABASE_URL=
# จำนวน connection สูงสุดของระบบนี้ (standards 1.8 deployment.md ข้อ 4.1) — server ตั้ง 5
DATABASE_POOL_MAX=5

# Core Hub (ผู้ให้ identity)
CORE_HUB_URL=http://localhost:3000
CORE_HUB_JWKS_URL=http://localhost:3000/api/v1/.well-known/jwks.json
# เว็บของ Core Hub — GET /auth/login พาไป {ค่านี้}/sso/authorize · POST /auth/logout พาไป {ค่านี้}/logout
# (ไม่ใส่ = http://127.0.0.1:3100 · production ต้องใส่) · ต้องตรงกับ core_hub_web_url ใน subsystem.yaml
CORE_HUB_WEB_URL=http://127.0.0.1:3100

# สัญญาที่ตรึงไว้ — ห้ามเปลี่ยนค่าเหล่านี้เอง (standards/contracts/jwt-contract.json)
CORE_HUB_ISSUER=core-hub
CORE_HUB_AUDIENCE=csmju2030

# ตัวตนของระบบย่อย — SUBSYSTEM_ID ต้องตรงกัน 3 ที่: ไฟล์นี้ · name ใน subsystem.yaml · ชื่อในทะเบียน Core Hub
# token ที่มี claim azp ต้องมี azp = SUBSYSTEM_ID (ขั้น 10 ของการตรวจ token)
SUBSYSTEM_ID=csmju-quiz
SUBSYSTEM_NAME=CSMJU Quiz

# origin สาธารณะของระบบ = frontend (ประตูเดียว) — next ของ /auth/login ตรวจกับ origin นี้
# และหลัง callback สำเร็จพาไป {ค่านี้}{next} · ใช้เป็น CORS origin ด้วย (ไม่จำเป็นแล้วเพราะเรียกผ่าน proxy)
# ใช้ localhost (ไม่ใช่ 127.0.0.1) ให้ตรงกับ Callback URL ที่ลงทะเบียน — คุกกี้ผูกกับชื่อ host
FRONTEND_URL=http://localhost:3102

# JWKS cache
JWKS_CACHE_TTL_MS=600000
JWKS_MIN_REFRESH_INTERVAL_MS=30000
JWKS_REQUEST_TIMEOUT_MS=5000
# clock skew ที่ยอมรับตอนตรวจ exp (สูงสุด 60 ตามสัญญา) · อายุ token (exp − iat) ต้องไม่เกิน 900 + 60 วินาทีเสมอ
JWT_CLOCK_TOLERANCE_SEC=5

# ผู้เล่นเข้าห้องด้วยบัตรเข้าห้องโดยไม่ล็อกอิน (PM อนุมัติ 2 ต.ค. 2569) — false = ปิด endpoint ของผู้เล่นทั้งหมด
GUEST_PLAY_ENABLED=true
# จำนวนครั้งที่ค้นห้อง/เข้าร่วมได้ต่อ IP ต่อนาที (เกินแล้วตอบ 429 + Retry-After)
GUEST_JOIN_RATE_LIMIT=30
