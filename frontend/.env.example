# คัดลอกเป็น .env.local แล้วแก้ค่าตามสภาพแวดล้อม (ห้าม commit .env.local)
# หน้าเว็บนี้รันที่ http://localhost:3102 (pnpm dev) — เปิดด้วย localhost ไม่ใช่ 127.0.0.1
# (ต้องตรงกับ callback ที่ลงทะเบียนไว้ใน Core Hub: http://localhost:3102/auth/callback)
#
# ประตูเดียว (standards 1.7.0 · connect-core-hub ข้อ 1): เบราว์เซอร์คุยกับหน้าเว็บนี้เท่านั้น
# next.config.ts ส่ง /api/* และ /auth/login · /auth/callback · /auth/logout ต่อไป backend
# คุกกี้ session csmju_quiz_access_token จึงผูกกับ origin ของหน้าเว็บ

# URL ของ backend ระบบย่อย csmju-quiz — ฝั่ง server เท่านั้น (ไม่ใช่ NEXT_PUBLIC_ เบราว์เซอร์ไม่เห็น)
# ใช้ตอน build และ start (rewrites ถูกเขียนลง .next ตอน build) · ไม่ตั้ง = http://127.0.0.1:3002
BACKEND_URL=http://127.0.0.1:3002
# URL หน้าเว็บของ Core Hub — ใช้กับลิงก์ "กลับหน้าหลัก" เท่านั้น (SSO เริ่มที่ /auth/login ของระบบนี้)
NEXT_PUBLIC_CORE_HUB_WEB_URL=https://csmju2030.jowave.com
# ชื่อระบบย่อยที่ลงทะเบียนกับ Core Hub
NEXT_PUBLIC_SUBSYSTEM_NAME=csmju-quiz
# NEXT_PUBLIC_API_BASE_URL · NEXT_PUBLIC_CORE_HUB_URL เลิกใช้แล้ว (ตั้งไว้ก็ไม่มีผล)
